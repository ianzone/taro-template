{
  "name": "taro-template",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "build:h5": "taro build --type h5",
    "dev": "nr dev:weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "dev:h5": "taro build --type h5 --watch",
    "lint": "biome check --fix .",
    "prepare": "lefthook install",
    "commit": "git add -A && git commit --no-edit",
    "squash": "bun ./scripts/squash.ts && git commit --no-edit --no-verify"
  },
  "dependencies": {
    "@taroify/core": "^0.7.0",
    "@tarojs/components": "^4.0.10",
    "@tarojs/plugin-framework-react": "^4.0.10",
    "@tarojs/plugin-http": "^4.0.10",
    "@tarojs/plugin-platform-weapp": "^4.0.10",
    "@tarojs/react": "^4.0.10",
    "axios": "^1.8.4",
    "tarojs-router-next": "^3.4.6"
  },
  "devDependencies": {
    "@es-proj/utils": "^1.6.5",
    "@tarojs/cli": "^4.0.10",
    "@tarojs/webpack5-runner": "^4.0.10",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "^4.0.10",
    "git-cz": "^4.9.0",
    "knip": "^5.48.0",
    "lefthook": "^1.11.8",
    "tarojs-router-next-plugin": "^3.4.6",
    "tsconfig-paths-webpack-plugin": "^4.2.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@parcel/watcher",
    "@tarojs/binding",
    "core-js",
    "core-js-pure"
  ]
}
