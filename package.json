{
  "name": "taro-template",
  "version": "1.0.0",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "build:h5": "taro build --type h5",
    "dev": "taro build --type weapp --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "dev:h5": "taro build --type h5 --watch",
    "lint": "biome check --fix .",
    "postinstall": "lefthook install",
    "commit": "git add -A && git commit --no-edit",
    "squash": "node ./squash.mjs && git commit --no-edit --no-verify"
  },
  "browserslist": ["defaults and fully supports es6-module", "maintained node versions"],
  "dependencies": {
    "@babel/runtime": "^7.26.9",
    "@taroify/core": "^0.6.3-alpha.0",
    "@tarojs/components": "^4.0.9",
    "@tarojs/plugin-framework-react": "^4.0.9",
    "@tarojs/plugin-http": "^4.0.9",
    "@tarojs/plugin-platform-weapp": "^4.0.9",
    "@tarojs/react": "^4.0.9",
    "@tarojs/runtime": "^4.0.9",
    "@tarojs/taro": "^4.0.9",
    "axios": "^1.7.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tarojs-router-next": "^3.4.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-react": "^7.26.3",
    "@biomejs/biome": "^1.9.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "^4.0.9",
    "@tarojs/taro-loader": "^4.0.9",
    "@tarojs/webpack5-runner": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "18.3.1",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "^4.0.9",
    "es-proj": "^1.2.0",
    "git-cz": "^4.9.0",
    "knip": "^5.44.1",
    "lefthook": "^1.10.10",
    "postcss": "^8.5.2",
    "react-refresh": "^0.16.0",
    "tarojs-router-next-plugin": "^3.4.6",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.3",
    "webpack": "^5.98.0",
    "zx": "^8.3.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@parcel/watcher",
    "@tarojs/binding",
    "core-js",
    "core-js-pure"
  ]
}
