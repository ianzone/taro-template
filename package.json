    "@tarojs/react": "4.0.8",
    "@tarojs/runtime": "4.0.8",
    "@tarojs/shared": "4.0.8",
    "@tarojs/taro": "4.0.8",
    "axios": "^1.7.9",
    "react": "18.3.1",
