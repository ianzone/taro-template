{
  "name": "vpt-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:wx": "cross-env VITE_VPT_TARGET=wx vite",
    "dev:zfb": "cross-env VITE_VPT_TARGET=zfb vite",
    "dev:tt": "cross-env VITE_VPT_TARGET=tt vite",
    "dev:h5": "cross-env VITE_VPT_TARGET=h5 vite",
    "build:wx": "cross-env VITE_VPT_TARGET=wx vite build",
    "build:zfb": "cross-env VITE_VPT_TARGET=zfb vite build",
    "build:tt": "cross-env VITE_VPT_TARGET=tt vite build",
    "build:h5": "cross-env VITE_VPT_TARGET=h5 vite build",
    "preview:h5": "cross-env VITE_VPT_TARGET=h5 vite preview --outDir dist/h5",
    "typecheck": "tsc -b",
    "lint": "biome check --fix .",
    "prepare": "lefthook install",
    "commit": "git add -A && git commit --no-edit",
    "squash": "bun ./scripts/squash.ts && git commit --no-edit --no-verify"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@es-proj/configs": "^2.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "czg": "^1.14.0",
    "knip": "^6.40.0",
    "lefthook": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-taro": "^0.7.11"
  }
}
